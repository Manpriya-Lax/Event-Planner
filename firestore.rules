rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    match /publicProfiles/{userId} {
      allow read: if true;
      allow create, update: if request.auth != null && request.auth.uid == userId;
      allow delete: if false;
    }

    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      match /friends/{friendId} {
        allow read:  if request.auth != null && request.auth.uid == userId;
        allow write: if request.auth != null &&
          (request.auth.uid == userId || request.auth.uid == friendId);
      }
    }

    match /events/{eventId} {
      allow read: if request.auth != null
        && request.auth.uid in resource.data.participantid;
      allow create: if request.auth != null
        && request.resource.data.ownerId == request.auth.uid
        && request.auth.uid in request.resource.data.participantid;
      allow update, delete: if request.auth != null
        && request.auth.uid == resource.data.ownerId;
    }

    match /friend_requests/{reqId} {
      allow read: if request.auth != null &&
        (request.auth.uid == resource.data.fromUid ||
         request.auth.uid == resource.data.toUid);
      allow create: if request.auth != null &&
        request.auth.uid == request.resource.data.fromUid;
      allow update, delete: if request.auth != null &&
        (request.auth.uid == resource.data.toUid ||
         request.auth.uid == resource.data.fromUid);
    }
  }
}